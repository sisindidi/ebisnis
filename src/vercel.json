{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/vendor/(.*)",
            "dest": "/vendor/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/favicon\\.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/robots\\.txt",
            "dest": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "installCommand": "echo 'Skipping frontend install (using prebuilt public/build assets)'",
    "buildCommand": "echo 'Using prebuilt public/build assets'",
    "outputDirectory": "public",
    "env": {
        "APP_NAME": "Esa Corner",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_TIMEZONE": "Asia/Jakarta",
        "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
        "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "LOG_CHANNEL": "stderr",
        "DEBUGBAR_ENABLED": "false",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require",
        "DB_EMULATE_PREPARES": "true"
    }
}
